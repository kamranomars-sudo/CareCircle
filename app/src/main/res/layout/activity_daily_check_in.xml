<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="6dp"
            android:text="←  Back"
            android:textColor="#287D6C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Daily Check-In"
            android:textColor="#173B35"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Record today's care and well-being"
            android:textColor="#607D78"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="How are they feeling today?"
            android:textColor="#173B35"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioGood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="😊 Good"
                android:textColor="#173B35" />

            <RadioButton
                android:id="@+id/radioOkay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="😐 Okay"
                android:textColor="#173B35" />

            <RadioButton
                android:id="@+id/radioNotWell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="😟 Not Well"
                android:textColor="#173B35" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Today's Care"
            android:textColor="#173B35"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#D5E7E2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkMeals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ate meals today"
                    android:textColor="#173B35"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/checkMedication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Took medications"
                    android:textColor="#173B35"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/checkWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Drank enough water"
                    android:textColor="#173B35"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/checkActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Completed daily activity"
                    android:textColor="#173B35"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Notes"
            android:textColor="#173B35"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top|start"
            android:hint="Add any notes about today..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="#173B35"
            android:textColorHint="#8AA09B"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCheckIn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="30dp"
            android:text="Save Check-In"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#287D6C"
            app:cornerRadius="16dp" />

    </LinearLayout>

</ScrollView>