<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="6dp"
            android:text="←  Back"
            android:textColor="#287D6C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Appointment"
            android:textColor="#173B35"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add appointment details and schedule"
            android:textColor="#607D78"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Appointment Title"
            android:textColor="#173B35"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="e.g. Family Doctor"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="#173B35"
            android:textColorHint="#8AA09B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Date"
            android:textColor="#173B35"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Select date"
            android:padding="14dp"
            android:textColor="#173B35"
            android:textColorHint="#8AA09B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Time"
            android:textColor="#173B35"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTime"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Select time"
            android:padding="14dp"
            android:textColor="#173B35"
            android:textColorHint="#8AA09B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Address"
            android:textColor="#173B35"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Enter appointment address"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:textColor="#173B35"
            android:textColorHint="#8AA09B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Notes"
            android:textColor="#173B35"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top|start"
            android:hint="Add appointment notes..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="#173B35"
            android:textColorHint="#8AA09B"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="View Appointment Map"
            android:textAllCaps="false"
            android:textColor="#287D6C"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="14dp"
            app:strokeColor="#287D6C"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAppointment"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="Save Appointment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#287D6C"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAppointment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:text="Delete Appointment"
            android:textAllCaps="false"
            android:textColor="#B3261E"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:strokeColor="#B3261E"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>