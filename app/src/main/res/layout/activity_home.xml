<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="CareCircle"
            android:textColor="#173B35"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Welcome to CareCircle"
            android:textColor="#607D78"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#287D6C"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Overview"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Keep your care tasks and appointments organized."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Quick Access"
            android:textColor="#173B35"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- CARE PROFILE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCareProfile"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:gravity="start|center_vertical"
            android:paddingStart="22dp"
            android:text="●   Care Profile"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:strokeColor="#D5E7E2"
            app:strokeWidth="1dp" />

        <!-- CARE TASKS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTasks"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:gravity="start|center_vertical"
            android:paddingStart="22dp"
            android:text="✓   Care Tasks"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:strokeColor="#D5E7E2"
            app:strokeWidth="1dp" />

        <!-- APPOINTMENTS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppointments"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:gravity="start|center_vertical"
            android:paddingStart="22dp"
            android:text="●   Appointments"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:strokeColor="#D5E7E2"
            app:strokeWidth="1dp" />

        <!-- EMERGENCY CONTACTS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergency"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:gravity="start|center_vertical"
            android:paddingStart="22dp"
            android:text="♡   Emergency Contacts"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:strokeColor="#D5E7E2"
            app:strokeWidth="1dp" />

        <!-- ABOUT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="22dp"
            android:text="ⓘ   About"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:strokeColor="#D5E7E2"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>