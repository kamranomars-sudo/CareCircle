<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="6dp"
            android:text="←  Back"
            android:textColor="#287D6C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Care Profile"
            android:textColor="#173B35"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Person receiving care"
            android:textColor="#607D78"
            android:textSize="15sp" />

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/profile_card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/profile_circle"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mary Carter"
                    android:textColor="#173B35"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Family Care Profile"
                    android:textColor="#607D78"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Basic Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Basic Information"
            android:textColor="#173B35"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/profile_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:textColor="#607D78"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="March 18, 1948"
                android:textColor="#173B35"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#D9E7E3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Primary Caregiver"
                android:textColor="#607D78"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Kamran"
                android:textColor="#173B35"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Care Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Care Information"
            android:textColor="#173B35"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCarePlan"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="♡   Care Plan"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="#C8DCD7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMedications"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="start|center_vertical"
            android:text="✚   Medications"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="#C8DCD7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppointments"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="start|center_vertical"
            android:text="●   Appointments"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="#C8DCD7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergencyContacts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="start|center_vertical"
            android:text="☎   Emergency Contacts"
            android:textAllCaps="false"
            android:textColor="#173B35"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="#C8DCD7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            android:text="✓  Daily Check-In"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#287D6C"
            app:cornerRadius="16dp" />

    </LinearLayout>

</ScrollView>